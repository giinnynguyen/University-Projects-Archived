@using HPMusic.Framework
@using HPMusic.Models
@using Microsoft.AspNet.Identity
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <link rel="shortcut icon" type="image/x-icon" href="/Assets/client/img/icon.png">
    <link rel="stylesheet" type="text/css" href="/Assets/client/css/style.css">
    <link rel="stylesheet" type="text/css" href="/Assets/client/css/index.css">
    <link rel="stylesheet" type="text/css" href="/Assets/client/font-awesome/css/font-awesome.min.css">
    <script type="text/javascript" src="/Assets/client/js/jquery.min.js"></script>
    <script type="text/javascript" src="/Assets/client/js/script.js"></script>
    <title>@ViewBag.Title</title>
    <!-- Start WOWSlider.com HEAD section --> <!-- add to the <head> of your page -->
    <link rel="stylesheet" type="text/css" href="/Assets/client/engine0/style.css" />
    <!--script type="text/javascript" src="engine0/jquery.js"></script-->
    <!-- End WOWSlider.com HEAD section -->
    @RenderSection("Styles", false)
</head>
<body>
    <div id="fb-root"></div>
    <script>
(function(d, s, id) {
  var js, fjs = d.getElementsByTagName(s)[0];
  if (d.getElementById(id)) return;
  js = d.createElement(s); js.id = id;
  js.src = "//connect.facebook.net/vi_VN/sdk.js#xfbml=1&version=v2.9&appId=1549417215109607";
  fjs.parentNode.insertBefore(js, fjs);
}(document, 'script', 'facebook-jssdk'));</script>


    <!-- header start -->
    <div class="header-wrap">
       <div class="header">
           <h4>SEARCH &nbsp;</h4>
           <div class="search-box">
               <div class="search">
                   <input type="text" name="search">
                   <span class="fa fa-search"></span>
               </div>
           </div>
           <!-- top navbar start -->
           
           <div class="top-nav">
               @if (Request.IsAuthenticated)
               {
                   using (Html.BeginForm("LogOff", "Account", FormMethod.Post, new { id = "logoutForm", @class = "navbar-right" }))
                   {
                    @Html.AntiForgeryToken()
                    <p>Hello  @User.Identity.GetUserName() </p>
                    <ul class="nav navbar-nav navbar-right">
                        <li><a href="javascript:document.getElementById('logoutForm').submit()">Log off</a></li>
                    </ul>
                   }
               }
               else
               {
                <ul>
                    <li>@Html.ActionLink("Đăng nhập","Login","Account")</li>
                    <li>@Html.ActionLink("Đăng ký", "Register", "Account")</li>
                    <li><a href="upload.html"><span class="fa fa-upload"></span>&nbsp;Tải lên</a></li>
                </ul>
               }
               
           </div>
           <!-- top navbar end -->
       </div>
        <!--register box start-->
        <!--register box end-->
    </div>
    <!-- header end -->
    <!-- menu nav start-->
    <div class="nav-wrap">
        <div class="nav">
            <ul>
                <li>@Html.ActionLink("Trang chủ", "Index", "Home", null, new { @class="link"})</li>
                <li>@Html.ActionLink("Nguyên tác", "Origin", "Home", null, new { @class = "link" })</li>
                <li>@Html.ActionLink("Cover", "Cover", "Home", null, new { @class = "link" })</li>
                <li>@Html.ActionLink("Nhạc cụ", "Instrutment", "Home", null, new { @class = "link" })</li>
                <li><a href="friend.html" title="Hoạt động bạn bè" class="link">Nghệ sĩ</a></li>
<li><a href="friend.html" title="Hoạt động bạn bè" class="link">Bạn bè</a></li>
            </ul>
        </div>
    </div>
    <!-- menu nav end -->
    <!-- banner start -->
    @RenderBody()
    <!-- main-end -->
    <!-- footer start -->
    <div class="clear"></div>
    <div class="footer-wrap">
        <ul>
            <li><a href="">Giới thiệu</a></li>
            <li><a href="">Điểu khoản</a></li>
            <li><a href="">Hỗ trợ</a></li>
            <li><a href="">Liên lạc</a></li>
        </ul>
        <div class="social">
            <ul class="A">
                &nbsp;
                <li><a href="#"><span class="fa fa-facebook-square"></span></a></li>
                <li><a href="#"><span class="fa fa-google-plus-square"></span></a></li>
                <li><a href="#"><span class="fa fa-pinterest-square"></span></a></li>
                <li><a href="#"><span class="fa fa-twitter"></span></a></li>
            </ul>
            <div class="B">&copy; 2017, HPmusic</div>
            <div class="C">&nbsp;</div>
        </div>
    </div>
    <!-- footer end -->
</body>
</html>
