@model HPMusic.Areas.Admin.Models.ManageSongModel
@using HPMusic.Models
@{
    ViewBag.Title = "Update";
    Layout = "~/Areas/Admin/Views/Shared/Admin_layout.cshtml";
}

<section class="content">
    <div class="row">
        <div class="col-xs-12">
            <div class="box">
                <!-- /.box-header -->
                <div class="box-body">
                    <table id="example2" class="table table-bordered table-hover">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>User</th>
                                <th>Tên bài hát</th>
                                <th>Loại</th>
                                <th>Ngày upload</th>
                                <th>Ngôn ngữ</th>
                                <th>Ca sĩ</th>
                                <th>Download</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                                @for(int i =0; i <Model.Song.Count;i++)
                                {
                                    <tr>
                                        <td>@Html.DisplayFor(model => model.Song[i].song_id)</td>
                                        <td>@{
                                            var username = SongDAO.DisplayUsernameFromUserID(Model.Song[i].user_id);
                                        }
                                        @username
                                        </td>
                                        <td>@Html.DisplayFor(model => model.Song[i].song_name)</td>
                                        @if (Model.Song[i].type==0) {
                                            <td>Nguyên tác</td>
                                        }
                                        else if (Model.Song[i].type == 1)
                                        {
                                            <td>Cover</td>
                                        }
                                        else
                                        {
                                            <td>Nhạc cụ</td>
                                        }
                                        <td>@Html.DisplayFor(model => model.Song[i].uploaded)</td>
                                        <td>
                                            @{
                                                var genreName = SongDAO.DisplayLanguageName(Model.Song[i].language_id);
                                            }
                                            @genreName

                                        </td>
                                        <td>@Html.DisplayFor(model => model.Song[i].singer)</td>
                                        <td>@Html.DisplayFor(model => model.Song[i].download)</td>
                                        <td>
                                            <a href="@Url.Action("Update", "Admin", new {id=Model.Song[i].song_id})" class="btn btn-info">
                                                <i class="fa fa-pencil"></i>
                                            </a>
                                            <a href="@Url.Action("Delete", "Admin", new {id=Model.Song[i].song_id})" class="btn btn-danger">
                                                <i class="fa fa-trash"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                        </tbody>
                    </table>
                </div>
                <!-- /.box-body -->
            </div>
        </div>
        <!-- /.col -->
    </div>
    <!-- /.row -->
</section>


<script>
    $(document).ready(function () {
        $('#example2').DataTable({
            "paging": true,
            "lengthChange": false,
            "searching": false,
            "ordering": true,
            "info": true,
            "autoWidth": false
        });
    });
</script>
