@using HPMusic.Models
@using HPMusic.Framework
@model HPMusic.Models.UserModel
@{
    ViewBag.Title = "User";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Styles {
    <link href="@Url.Content("/Assets/client/css/profile.css")" rel="stylesheet" type="text/css" />
}
<div class="alert-login">
    <div class="notify success">
        <a href="#" class="icon fa fa-times-circle"></a>
        <div class="text">Bạn phải đăng nhập để sử dụng chức năng này!</div>
    </div>
</div>
<!-- banner start -->
<div class="banner-wrap">
    <div class="banner">
        <dl>
            <dt>
                <span>
                    <img src="@SongDAO.avatar(Model.User.user_id)" alt="abc">
                </span>
            </dt>
            <dd>
                <div class="rank">
                    <h1 class="left">@Html.DisplayFor(model => model.Profile.displayname) (@Html.DisplayFor(model => model.Profile.title))</h1>

                </div>
                <div class="clear"></div>
                <div class="short-info">
                    <span class="left">
                        <span class="singer">@Html.DisplayFor(model => model.User.username)</span>
                    </span>
                    <span class="left sex">
                        @if (Model.Profile.sex == true)
                        {
                            <i class="fa fa-venus"></i>
                        }
                        else
                        {
                            <i class="fa fa-mars"></i>
                        }
                        &nbsp;&nbsp;Đến từ: @Html.DisplayFor(model => model.Profile.place) &nbsp;&nbsp;|&nbsp;&nbsp; Nghề nghiệp: @Html.DisplayFor(model => model.Profile.job)
                    </span>

                </div>
                <div class="job">
                    <span></span>

                </div>

                <div class="social">
                    <ul>
                        <li>
                            @{
                                var listFollow = UserDAO.numFollow(Model.User.user_id);
                                var numFollow = listFollow.Count;
                            }
                            <div class="number">
                                <p>Theo dõi </p>
                                <a href="javascript:void(0)">@numFollow</a>
                            </div>
                        </li>

                        <li>
                            @{ var listFollower = UserDAO.numFollower(Model.User.user_id);
                                var numFollower = listFollower.Count;}
                            <div class="number">
                                <p>Người theo dõi </p>
                                <a href="javascript:void(0)">@numFollower</a>
                            </div>
                        </li>
                        @{ user userLogin = Session["UserLogin"] as user;}
                        @if (userLogin != null)
                        {
                            <li>
                                @if (userLogin.user_id == Model.User.user_id)
                                {

                                }
                                else
                                {
                                    <div class="number">
                                        <a href="javascript:void(0)" class="follow" id="follow">
                                            @if (UserDAO.CheckFollow(Model.User.user_id, userLogin.user_id))
                                            {
                                                <span>Đang theo dõi</span>
                                            }
                                            else
                                            {
                                                <span>Theo dõi</span>
                                            }

                                        </a>
                                    </div>
                                }
                            </li>

                        }else
                        {
                            <li><div class="number">
    <a href="javascript:void(0)" class="follow" id="follow">
            <span>Theo dõi</span>
    </a>
</div>
                        </li>
                        }
                    </ul>
                </div>
                <script>

                    $(function () {
                        $("#follow").click(function () {
                            $.ajax({
                                url: '@Url.Action("Follow","User")',
                                dataType: "json",
                                type: "GET",
                                contentType: 'application/json; charset=utf-8',
                                data: {userid: @Model.User.user_id},
                                success: function (data) {
                                    if (data == "nologin") {
                                        $(".alert-login").show();
                                        setTimeout(hideAlert,2000);
                                    } else if(data == "Following") {
                                        $("#follow").text("Theo dõi");
                                    }else{
                                        $("#follow").text("Đang theo dõi");
                                    }
                                },
                                error: function (xhr) {
                                    alert('error');
                                }
                            });
                        });
                        function hideAlert(){
                            $(".alert-login").hide();
                        }

                        $(".addFriendBtn").click(function(){
                            $.ajax({
                                url: '@Url.Action("Profile", "User")',
                                dataType: "json",
                                type: "GET",
                                contentType: 'application/json; charset=utf-8',
                                data: {idFriend: @Model.User.user_id},
                                success: function (data) {
                                    if(data == "NoLogin"){
                                        $(".alert-login").show();
                                        setTimeout(hideAlert,2000);
                                    }
                                    else if(data == "Friend"){
                                        $(".addFriend").html('<span class="fa fa-flus">&nbsp;Kết bạn</span>');
                                    }else{
                                        $(".addFriend").html('<span class="fa fa-check">&nbsp;Đã gửi lời mời kết bạn</span>');
                                    }
                                },
                                error: function (xhr) {
                                    alert('error');
                                }
                            });
                        }
                    );
                    });
                </script>
            </dd>
        </dl>
    </div>
</div>
<!-- banner end -->
<!-- main start -->
<div class="content">
    <!-- left start -->
    <div class="content-left">
        <!-- latest song start	 -->
        <div class="list-song latest-song">
            <div class="list-title">
                <h2>Bài hát mới</h2>
            </div>
            <div class="list-body">
                <ul>
                    @if (Model.SongUser.Count < 5)
                    {
                        for (int i = 0; i < @Model.SongUser.Count; i++)
                        {
                            <li>
                                <span class="left list-name">
                                    @Html.ActionLink(@Model.SongUser[i].song_name, "Play", "Play", new { @id = @Model.SongUser[i].song_id }, null)
                                </span>
                                <span class="luotnghe">@Model.SongUser[i].download lượt tải</span>
                                <span class="list-action">
                                    <a href=""><span class="fa fa-headphones"></span></a>
                                    <a href="@Url.Action("Download", "Play", new { id = Model.SongUser[i].song_id })"><span class="fa fa-download"></span></a>
                                    <a href=""><span class="fa fa-share-square"></span></a>
                                    <a href=""><span class="fa fa-heart"></span></a>
                                </span>
                            </li>
                        }
                    }
                    else
                    {
                        for (int i = 0; i < 5; i++)
                        {
                            <li>
                                <span class="left list-name">
                                    @Html.ActionLink(@Model.SongUser[i].song_name, "Play", "Play", new { @id = @Model.SongUser[i].song_id }, null)
                                </span>
                                <span class="luotnghe">@Model.SongUser[i].download lượt tải</span>
                                <span class="list-action">
                                    <a href=""><span class="fa fa-headphones"></span></a>
                                    <a href="@Url.Action("Download", "Play", new { id = Model.SongUser[i].song_id })"><span class="fa fa-download"></span></a>
                                    <a href=""><span class="fa fa-share-square"></span></a>
                                    <a href=""><span class="fa fa-heart"></span></a>
                                </span>
                            </li>
                        }
                    }
                </ul>
            </div>
        </div>
        <!-- lastest-song end -->
        <!-- hot song start	 -->
        <div class="list-song latest-song">
            <div class="list-title">
                <h2>Bài hát nổi bật</h2>
            </div>
            <div class="list-body">
                <ul>
                    @if (Model.SongUserPopular.Count < 10)
                    {
                        for (int i = 0; i < @Model.SongUserPopular.Count; i++)
                        {
                            <li>
                                <span class="left list-name">
                                    @Html.ActionLink(@Model.SongUserPopular[i].song_name, "Play", "Play", new { @id = @Model.SongUserPopular[i].song_id }, null)
                                </span>
                                <span class="luotnghe">@Model.SongUserPopular[i].download lượt tải</span>
                                <span class="list-action">
                                    <a href=""><span class="fa fa-headphones"></span></a>
                                    <a href="@Url.Action("Download", "Play", new { id = Model.SongUserPopular[i].song_id })"><span class="fa fa-download"></span></a>
                                    <a href=""><span class="fa fa-share-square"></span></a>
                                    <a href=""><span class="fa fa-heart"></span></a>
                                </span>
                            </li>
                        }
                    }
                    else
                    {
                        for (int i = 0; i < 10; i++)
                        {
                            <li>
                                <span class="left list-name">
                                    @Html.ActionLink(@Model.SongUserPopular[i].song_name, "Play", "Play", new { @id = @Model.SongUserPopular[i].song_id }, null)
                                </span>
                                <span class="luotnghe">@Model.SongUserPopular[i].download lượt tải</span>
                                <span class="list-action">
                                    <a href=""><span class="fa fa-headphones"></span></a>
                                    <a href="@Url.Action("Download", "Play", new { id = Model.SongUserPopular[i].song_id })"><span class="fa fa-download"></span></a>
                                    <a href=""><span class="fa fa-share-square"></span></a>
                                    <a href=""><span class="fa fa-heart"></span></a>
                                </span>
                            </li>
                        }
                    }
                </ul>
            </div>
        </div>
        <!-- hot-song end -->
    </div>
    <!-- left end -->
    <div class="content-right">
        <div class="stt">
            <div class="top">
                <h3>Trạng thái</h3>
            </div>
            <div class="bottom">
                <p>Đây là một stt ẩn, chỉ có người đẹp gái mới thấy</p>
            </div>
        </div>
        <div class="follow">
            <div class="top">
                <h3>Theo dõi</h3>
            </div>
            <div class="list-follow">
                <ul>
                    @if (numFollow < 8)
                    {
                        for (int i = 0; i < numFollow; i++)
                        {
                            user userFollow = UserDAO.UserFromID(listFollow[i]);
                            <li>
                                <a href="@Url.Action("User","User",new { id = listFollow[i]})">
                                    <img src="@SongDAO.avatar(listFollow[i])" alt="">
                                    <div class="fan-name">@userFollow.username</div>
                                </a>
                            </li>
                        }
                    }
                    else
                    {
                        for (int i = 0; i < 8; i++)
                        {
                            user userFollow = UserDAO.UserFromID(listFollow[i]);
                            <li>
                                <a href="@Url.Action("User","User",new { id = listFollow[i]})">
                                    <img src="@SongDAO.avatar(listFollow[i])" alt="">
                                    <div class="fan-name">@userFollow.username</div>
                                </a>
                            </li>
                        }
                    }
                </ul>
            </div>
        </div>
        <div class="fans">
            <div class="top">
                <h3>Người theo dõi</h3>
            </div>
            <div class="fan-list">
                <ul>
                    @if (numFollower < 8)
                    {
                        for (int i = 0; i < numFollower; i++)
                        {
                            user userFollow = UserDAO.UserFromID(listFollower[i]);
                            <li>
                                <a href="@Url.Action("User","User",new { id = listFollower[i]})">
                                    <img src="@SongDAO.avatar(listFollower[i])" alt="avatar">
                                    <div class="fan-name">@userFollow.username</div>
                                </a>
                            </li>
                        }
                    }
                    else
                    {
                        for (int i = 0; i < 8; i++)
                        {
                            user userFollow = UserDAO.UserFromID(listFollower[i]);
                            <li>
                                <a href="@Url.Action("User","User",new { id = listFollower[i]})">
                                    <img src="@SongDAO.avatar(listFollower[i])" alt="avatar">
                                    <div class="fan-name">@userFollow.username</div>
                                </a>
                            </li>
                        }
                    }
                </ul>
            </div>
        </div>
    </div>

</div>
<!-- main end -->
