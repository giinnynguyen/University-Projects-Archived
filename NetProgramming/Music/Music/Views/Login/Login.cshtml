@model HPMusic.Models.LoginModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <title>Đăng nhập</title>
    <link rel="stylesheet" type="text/css" href="/Assets/client/css/style.css">
    <link rel="stylesheet" type="text/css" href="/Assets/client/css/login.css">
    <link rel="stylesheet" type="text/css" href="/Assets/client/font-awesome/css/font-awesome.min.css">
    <script type="text/javascript" src="/Assets/client/js/jquery.min.js"></script>
    <meta charset="utf-8">
    <style>
        
    </style>
</head>
<body>
        <!-- logo start -->
        <div class="logo wap">
            <a href="@Url.Action("Index","Home")">
                <img src="/Assets/client/img/logo.png" alt="logo image">
            </a>
        </div>
        <!-- logo end -->
        <!-- form login start -->

        <div class="lg-content">
            <div class="bg">
                <div class="lg-background wap">
                    <ul class="login">
                        @using (Html.BeginForm("Login", "Login", FormMethod.Post, new { @class="form"}))
                        {
                            <li class="item">
                                @Html.TextBoxFor(model => model.User.username,new { @class="username", @placeholder="Tài khoản" })
                            </li>
                            <span class="user-mess"></span>
                            <li class="item">
                                @Html.PasswordFor(model => model.User.pass, new { @class = "pass", @placeholder = "Mật khẩu" })
                            </li>
                            <span class="pass-mess"></span>
                            <li>
                                <span class="left">
                                    <input type="checkbox" name="savepass">
                                    <label for="savepass">Ghi nhớ</label>
                                </span>
                                <!-- forget password -->
                                <a class="forget right" href="@Url.Action("ForgotPass","Login")">Quên mật khẩu</a>
                            </li>
                            <li>
                                <input type="submit" class="login-btn left" value="Đăng nhập">
                                @Html.ActionLink("Đăng ký", "Register", "Register",new { }, new { @class= "register right"})
                            </li>
                            <li class="lg-bottom">
                                <a href="" class="fa fa-facebook right fb"></a>
                                <a href="" class="fa fa-google-plus right gg"></a>
                            </li>
                        }
                    </ul>
                </div>

            </div>
        </div>
    @Html.Hidden("RedirectTo", Url.Action("Index", "Home"));
        <script src="~/Assets/client/js/login.js"></script>
        <p class="bottom-bar">
            @Html.ActionLink("Trang chủ", "Index", "Home")
            &nbsp;&nbsp;|&nbsp;&nbsp;
            <a>Trợ giúp</a>
           
        </p>
        <!-- form login end -->
</body>
</html>
