@model HPMusic.Framework.user
<div class="member-frame member-card">
    <div class="memberCard">
        <div class="avatarCropper">
            <a href="#">
                <img alt="a" src="http://i.imgur.com/TsImulS.png">
            </a>
        </div>
        <div class="userInfo">
            <h3 class="username">
                <a href="#" id="username">@Model.username</a>
            </h3>
            <h4 class="title">Sếp Thắng</h4>
            <div class="userTitle">
                <div class="info">Giới tính: Nam </div>
                <div class="info">Nghề nghiệp: Culi</div>
                <div class="info">Ngày sinh: 1/1/2017</div>
                <div class="info">Địa chỉ: Nông Lâm</div>
                <div class="info">Email: vanthang@gmail.com</div>
            </div>
            <div class="rela">
                <a class="makeFriend">
                    <span class="fa fa-user-times">&nbsp;Hủy bạn</span>
                </a>
            </div>
        </div>
        <a class="closeMember">X</a>
    </div>
</div>
